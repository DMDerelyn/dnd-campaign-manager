    "obsidian": "latest",
    "tslib": "^2.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "zod": "~3.25.76"
  }
